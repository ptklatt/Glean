<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>Glean</PackageId>
        <Authors>Philip Klatt</Authors>
        <Description>A usability layer over System.Reflection.Metadata for traversal, signature decoding, and explicit cross assembly resolution.</Description>
        <PackageProjectUrl>https://github.com/ptklatt/glean</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ptklatt/glean</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <DebugType>portable</DebugType>
        <EmbedAllSources>true</EmbedAllSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.Reflection.Metadata" Version="10.0.5" />
    </ItemGroup>

    <ItemGroup>
      <None Include="../../LICENSE" Pack="true" PackagePath="/" />
      <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Glean.Tests" />
      <Folder Include="Contexts\" />
      <Folder Include="Decoding\" />
      <Folder Include="Enumerators\" />
      <Folder Include="Extensions\" />
    </ItemGroup>

</Project>
